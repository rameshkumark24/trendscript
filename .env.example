# Required: get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: any Groq chat model that supports JSON mode (default: llama-3.1-8b-instant)
GROQ_MODEL=

# Optional: max API requests per client IP per minute, per server instance (default: 20, 0 disables)
RATE_LIMIT_PER_MINUTE=
